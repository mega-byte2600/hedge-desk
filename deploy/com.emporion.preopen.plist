<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.emporion.preopen</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/astra/workspace/projects/hedge-desk/scripts/run_preopen.sh</string>
    </array>

    <!-- Fire every day at 8:00am EST (5:00 local, DST-safe) so the AM report and
         morning briefing are fresh and ready before the 9:00am EST open. The
         4:30pm job ingests the close; this job turns the overnight/weekend
         research into the pre-open briefing. A real desk opens at 9am with a
         fresh report, closed at 4pm, research running 24/7 underneath. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>5</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/astra/workspace/projects/hedge-desk/artifacts/logs/preopen.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/astra/workspace/projects/hedge-desk/artifacts/logs/preopen.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
